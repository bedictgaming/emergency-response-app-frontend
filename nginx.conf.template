server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;
  # This is a static Next.js export, so framework hydration scripts require
  # inline execution. Session credentials are therefore kept out of JS; this
  # policy still blocks unapproved script hosts, plugins and framing.
  add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' ${PUBLIC_ASSET_ORIGIN} 'unsafe-inline'; style-src 'self' ${PUBLIC_ASSET_ORIGIN} 'unsafe-inline'; img-src 'self' https: data: blob:; connect-src 'self' ${PUBLIC_API_ORIGIN} https://api.cloudinary.com https://nominatim.openstreetmap.org; font-src 'self' data:; worker-src 'self' blob:; manifest-src 'self'" always;
  error_page 404 /404.html;
  location = /404.html { internal; }
  # Missing APIs stay machine-readable; never mask them with a browser page.
  location = /api { error_page 404 = @api_not_found; return 404; }
  location ^~ /api/ { error_page 404 = @api_not_found; return 404; }
  location @api_not_found { default_type application/json; return 404 '{"message":"Not found"}'; }
  location / { try_files $uri $uri.html $uri/ =404; }
  location = /sw.js { add_header Cache-Control "no-cache"; }
}
