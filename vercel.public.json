{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run deploy:build",
  "outputDirectory": "out",
  "cleanUrls": true,
  "proxy": { "entrypoint": "gateway/proxy.js", "matcher": "/api/:path*" },
  "functions": { "api/events/v1/socket.io.mjs": { "maxDuration": 75 } },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data: blob:; connect-src 'self' https://api.cloudinary.com https://nominatim.openstreetmap.org; font-src 'self' data:; worker-src 'self' blob:; manifest-src 'self'" }
      ]
    },
    {
      "source": "/(.*)",
      "missing": [{ "type": "host", "value": "cordova-emergency-response\\.site" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, nosnippet" }]
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "query", "key": "resetToken" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, nosnippet" }]
    },
    {
      "source": "/api/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ]
}
