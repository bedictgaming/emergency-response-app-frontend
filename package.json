{
  "name": "emergency-response-app-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "release:check": "node scripts/release-preflight.mjs",
    "deploy:check": "node scripts/deployment-preflight.mjs",
    "deploy:build": "node scripts/deploy-build.mjs",
    "test:deployment": "node --test scripts/deployment-policy.test.mjs",
    "test:gateway": "node --test gateway/sign-request.test.mjs",
    "test:worker": "node --test scripts/notification-worker.test.mjs",
    "prebuild": "node scripts/validation-preflight.mjs",
    "dev": "next dev",
    "build": "next build",
    "preview:pwa": "npm run build && node scripts/serve-pwa.mjs",
    "start": "next start",
    "lint": "eslint",
    "test:e2e": "playwright test",
    "test:e2e:dev": "playwright test --config=playwright.dev.config.ts"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.21",
    "@vercel/functions": "3.9.9",
    "axios": "^1.20.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.17.0",
    "motion": "^13.4.0",
    "next": "^16.3.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.7.0",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
